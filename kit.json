{
  "name": "Footsteps kit",
  "note": "Lists the sample files for each drum. Paths are relative to this file. A drum with no files keeps its synthesised 808 voice. Layers are chosen by velocity (upTo is the highest velocity, in percent, a layer plays); takes within a layer rotate on every hit.",
  "drums": {
    "BD": { "name": "Kick",     "folder": "samples/kick",     "layers": [ { "upTo": 40, "files": [] }, { "upTo": 75, "files": [] }, { "upTo": 130, "files": [] } ] },
    "SD": { "name": "Snare",    "folder": "samples/snare",    "layers": [ { "upTo": 40, "files": [] }, { "upTo": 75, "files": [] }, { "upTo": 130, "files": [] } ] },
    "RS": { "name": "Rim",      "folder": "samples/rim",      "layers": [ { "upTo": 130, "files": [] } ] },
    "CP": { "name": "Clap",     "folder": "samples/clap",     "layers": [ { "upTo": 130, "files": [] } ] },
    "CH": { "name": "Hat",      "folder": "samples/hat",      "layers": [ { "upTo": 40, "files": [] }, { "upTo": 75, "files": [] }, { "upTo": 130, "files": [] } ] },
    "OH": { "name": "Open hat", "folder": "samples/open-hat", "layers": [ { "upTo": 130, "files": [] } ], "chokedBy": ["CH"] },
    "LT": { "name": "Lo tom",   "folder": "samples/lo-tom",   "layers": [ { "upTo": 130, "files": [] } ] },
    "HT": { "name": "Hi tom",   "folder": "samples/hi-tom",   "layers": [ { "upTo": 130, "files": [] } ] },
    "CB": { "name": "Cowbell",  "folder": "samples/cowbell",  "layers": [ { "upTo": 130, "files": [] } ] },
    "CY": { "name": "Cymbal",   "folder": "samples/cymbal",   "layers": [ { "upTo": 130, "files": [] } ] }
  }
}
