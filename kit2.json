{
  "name": "Kit 2",
  "folder": "samples/Kit2",
  "format": "WAV, 48 kHz, 24-bit, stereo",
  "velocity": "upTo is the highest step velocity a layer plays, in percent. Layers were set from the recordings themselves: each one plays where its own recorded level matches the hit, so a full step (100%) lands on the hardest strokes and a soft step (42%) on a middle one. Strokes recorded within 2 dB of each other are grouped as takes of one layer and rotate from hit to hit.",
  "startMs": "where the hit begins in the file (first sample above 5% of the file's peak)",
  "peakDb": "peak level of the file, for reference",
  "rows": {
    "BD": "kick",
    "SD": "snare",
    "CH": "hat-closed",
    "OH": "hat-open",
    "LT": "floor-tom",
    "HT": "tom",
    "CY": "ride",
    "CR": "crash-small"
  },
  "rowsNote": "Which sound each voice plays. Any sound below can go on a lane: for example CR can be crash-large or splash, CY ride-bell.",
