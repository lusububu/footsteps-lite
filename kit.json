{
  "name": "Footsteps acoustic kit",
  "folder": "samples",
  "format": "WAV, 44.1 kHz, 16-bit, stereo",
  "velocity": "upTo is the highest step velocity a layer plays, in percent. A full step is 100%, a soft step 42%, ghost notes and hat fills about 13 to 40%; accents and the drummer's swell can go past 100%. Within a layer the level follows the velocity.",
  "startMs": "where the hit begins in the file (first sample above 5% of the file's peak); playback starts there so every hit lands on time",
  "peakDb": "peak level of the file, for reference",
  "rows": {
    "BD": "kick",
    "SD": "snare",
    "CH": "hat-closed",
    "OH": "hat-open",
    "HT": "tom",
    "LT": "floor-tom",
    "CY": "ride",
    "RS": null,
    "CP": null,
    "CB": null
  },
  "rowsNote": "Which sound each sequencer row plays. null keeps the row's 808 voice (there are no rim, clap or cowbell samples). Cymbal can be set to ride, crash-small or crash-large.",
  "articulations": {
    "CH": {
      "half": "hat-loose"
    }
  },
  "articulationsNote": "hat-loose is the half-open hat; the app has no half-open step yet, so it is listed for later.",
